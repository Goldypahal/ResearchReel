# Copy to backend/.env for local development.
NODE_ENV=development
PORT=5000

# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchreel
REDIS_URL=redis://localhost:6379
# At least 32 random characters in production: `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# Encrypts users' saved API keys (defaults to JWT_SECRET). `openssl rand -hex 32`
ENCRYPTION_KEY=

# The web app's public URL(s), comma separated. Used for CORS (direct uploads) and email links.
FRONTEND_URL=http://localhost:3000

# Email (any SMTP provider: Resend, SendGrid, Brevo, Mailgun, Gmail app password...)
# Without SMTP in development, codes and links are printed to the console.
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ResearchReel <no-reply@yourdomain.com>"

# AI (optional). Enables paper Q&A, summaries, AI reel scripts and narration.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Research RAG service (backend/research_rag): multi-paper search with page citations
# and research tools. Leave RAG_SERVICE_URL empty to disable; RAG_API_KEY must match the service.
RAG_SERVICE_URL=
RAG_API_KEY=
# AI_DAILY_LIMIT=100

# File storage. Default: local disk (mount a persistent disk here in production).
# UPLOAD_DIR=./public/uploads
# Or any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2...):
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.yourdomain.com

# Optional tuning
# START_WORKER=true          # run the media worker inside the API process
# MAX_VIDEO_MB=200
# REEL_MIN_SECONDS=3
# REEL_MAX_SECONDS=180
# API_RATE_LIMIT=300         # requests per minute per IP
# DATABASE_SSL=false         # set true when connecting to a DB that requires TLS
# CROSSREF_MAILTO=you@example.com

# Malware scanning of uploads with ClamAV (clamd). When set, infected files are rejected
# and uploads fail closed if the scanner is unreachable. Leave empty to skip scanning.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Public origin for one-click unsubscribe links in emails (defaults to FRONTEND_URL,
# which works because the web app proxies /api to this server).
# PUBLIC_API_ORIGIN=
