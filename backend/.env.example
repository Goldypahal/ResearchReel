# Backend settings for running the API directly (npm run dev).
# For Docker, use the root .env.example instead.
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchreel
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3000

# openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
OTP_TTL_SECONDS=600

# Email. Without SMTP settings, development prints codes to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# AI
GEMINI_API_KEY=
RAG_SERVICE_URL=http://localhost:8000/api/v1
RAG_API_KEY=

# Malware scanning (clamd). Leave empty to skip scanning in development.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Optional
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
ELASTICSEARCH_URL=
# Run background jobs in this process (default). Set to false when a separate worker runs.
START_WORKER=true
