{
  "name": "backend",
  "version": "1.0.0",
  "description": "ResearchReel API server",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/worker.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
    "migrate": "node-pg-migrate up",
    "migrate:create": "node-pg-migrate create",
    "seed": "node src/scripts/seed.js",
    "lint": "node --check src/server.js",
    "rag:reindex": "node src/scripts/ragReindex.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "argon2": "^0.44.0",
    "axios": "^1.18.1",
    "bullmq": "^5.78.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "engines": {
    "node": ">=20"
  }
}
