# Shared secret; ResearchReel's API sends it as X-API-Key. Required in production.
RAG_API_KEY=change-me

# Provider: gemini (default when a key is set), ollama (fully local) or test.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: Cohere reranking improves which passages are used.
COHERE_API_KEY=

# Each enabled step costs one extra LLM call per question.
ENABLE_QUERY_PLANNER=true
ENABLE_QUERY_DECOMPOSITION=true
ENABLE_ADAPTIVE_RETRIEVAL=true
ENABLE_CITATION_CHECK=true
ENABLE_ENTITY_EXTRACTION=true

# Local mode (LLM_PROVIDER=ollama, install requirements-local.txt)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
