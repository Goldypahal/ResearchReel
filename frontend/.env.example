# Frontend settings (inlined at build time). Copy to .env.local for development.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_WSS_URL=http://localhost:5000
NEXT_PUBLIC_SUPPORT_EMAIL=
# Public address of the site, used for link previews and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: API address for server-side requests if it differs from NEXT_PUBLIC_API_URL
API_INTERNAL_URL=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
