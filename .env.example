# ResearchReel — settings for `docker compose up`. Copy to .env and fill in.
# Generate secrets with:  openssl rand -hex 32

# ── Public address ────────────────────────────────────────────────────────────
# The URL people use to reach the site (the nginx gateway). Used for links,
# cookies, OAuth redirects and the frontend's API URL.
PUBLIC_URL=http://localhost:8080
PUBLIC_PORT=8080

# ── Required secrets ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# 32 bytes as 64 hex characters. Encrypts users' stored AI keys; keep it stable.
ENCRYPTION_KEY=
# Shared secret between the API and the RAG service.
RAG_API_KEY=

# ── Email (verification codes, password resets) ──────────────────────────────
# Any SMTP provider (SES, Postmark, Mailgun, Gmail app password…).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ResearchReel <no-reply@example.org>"

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=
QDRANT_URL=
QDRANT_API_KEY=

# ── Optional integrations ─────────────────────────────────────────────────────
# ORCID sign-in for the verified scholar badge (https://orcid.org/developer-tools)
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Use https://sandbox.orcid.org while testing
ORCID_BASE_URL=
# Extra university email domains accepted for the student badge (comma separated)
ACADEMIC_EMAIL_DOMAINS=

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SCHOLAR_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Shown on the Help page as the contact address
SUPPORT_EMAIL=
# Error tracking and product analytics (frontend)
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
